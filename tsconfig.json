{
  // Type-checks src/core from its JSDoc comments (npm run typecheck). Nothing is compiled; the browser runs the .js files as they are.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true
  },
  "include": ["app/src/core/**/*.js"]
}
